[Unit]
Description=Course Predator authoritative game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=course-predator
WorkingDirectory=/opt/course-predator
EnvironmentFile=/etc/course-predator/server.env
ExecStart=/opt/course-predator/.venv/bin/python -m course_predator.server --host 0.0.0.0 --port 50007
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
